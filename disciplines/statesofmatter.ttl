###  https://w3id.org/emmo#EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8
:EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8 rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2 ,
                                                           :EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
                                           owl:disjointWith :EMMO_a2b006f2_bbfd_4dba_bcaa_3fca20cd6be1 ;
                                           rdfs:seeAlso isbn:9780471400653 ;
                                           skos:example "Gas, liquid, plasma,"@en ;
                                           skos:prefLabel "Fluid"@en ;
                                           :OWLRL2DLAxioms "Equivalent To: Gas or Plasma or Liquid"@en ;
                                           :elucidation "A continuum that has no fixed shape and yields easily under an applied shear stress, or external force."@en ;
                                           :wikipediaReference <https://en.wikipedia.org/wiki/Fluid> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8 ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "Fluid"@en ;
   :etymology "From Latin fluidus (“flowing; fluid”), from Latin fluō (“to flow”), from Proto-Indo-European *bʰleh₁- (“to swell; surge; overflow; run”) [Wiktionary]"@en
 ] .


###  https://w3id.org/emmo#EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2
:EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2 rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_bc37743c_37c4_4ec7_9d58_d1aae5567352 ;
                                           rdfs:seeAlso <https://doi.org/10.2777/417118> ,
                                                        isbn:9780521405980 ;
                                           skos:example "A single continuum individual can be the whole fluid in a pipe."@en ;
                                           skos:prefLabel "ContinuumSubstance"@en ;
                                           :conceptualisation """Continuum is usually an assumption made relative to a specific entity and scale of observation. We can define a continuum substance as a substance for which continuum mechanics (i.e., solid or fluid mechanics) can be used as a model for the description and prediction of its behaviour.
Paramount to this definition is the applicability of the continuum assumption, that is usually made by comparing the scale of the constituents' phenomena (e.g., mean free path of a molecule in a gas) and the scale of the macro-entity (e.g., the container of the gas)."""@en ;
                                           :elucidation "A substance that is made of sufficiently large number of smaller parts such that it is the bearer of qualities that can exist only by the fact that it is a sum of parts."@en ;
                                           :note "A continuum is the bearer of properties that are generated by the interactions of its fundamental parts, such as viscosity and thermal or electrical conductivity. In fact, viscosity or electrical conductivity are properties of the macro-entity (e.g., solid, fluid), and not of the constituents (e.g., atoms or molecules)."@en ;
                                           :wikipediaReference <https://en.wikipedia.org/wiki/Continuum_mechanics> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2 ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "ContinuumSubstance"@en ;
   rdfs:seeAlso <https://en.wiktionary.org/wiki/continuum> ;
   :etymology "From Latin continuum, neuter form of continuus, from contineō (“contain, enclose”) [Wiktionary]"@en
 ] .


###  https://w3id.org/emmo#EMMO_94010cbc_c2a6_4cb9_b29a_83aa99d2ff70
:EMMO_94010cbc_c2a6_4cb9_b29a_83aa99d2ff70 rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_560d833a_6184_410c_859a_05d982712fd7 ;
                                           rdfs:seeAlso isbn:9780195129991 ;
                                           skos:example "Fog"@en ,
                                                        "Mist"@en ,
                                                        "Steam"@en ;
                                           skos:prefLabel "LiquidAerosol"@en ;
                                           :conceptualisation "A liquid aerosol is a two-phase system: tiny droplets of liquid suspended in a gas. The substance in the droplets is still in its condensed liquid phase, just finely divided. These droplets are large enough (typically ~0.1–100 µm) to scatter light, which is why aerosols are visible."@en ;
                                           :elucidation "An aerosol composed of liquid droplets in air or another gas."@en .


