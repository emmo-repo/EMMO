###  https://w3id.org/emmo#EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd
:EMMO_4a464c8d_8895_44a8_a628_aed13509f1bd rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_0b15f4ae_092e_4487_9100_3c44176c545c ,
                                                           :EMMO_0e030040_98a7_49b2_a871_dced1f3a6131 ,
                                                           :EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
                                           rdfs:comment "Suspensions show no significant effect on visible light."@en ;
                                           skos:prefLabel "Suspension"@en ;
                                           :OWLRL2DLAxioms "Equivalent To: SolidSolidSuspension or SolidLiquidSuspension or LiquidGasSuspension or LiquidLiquidSuspension or SolidGasSuspension or GasSolidSuspension or GasLiquidSuspension or LiquidSolidSuspension" ;
                                           :elucidation "An heterogeneous mixture that contains coarsly dispersed particles (no Tyndall effect), that generally tend to separate in time to the dispersion medium phase."@en ;
                                           :wikipediaReference <https://en.wikipedia.org/wiki/Suspension_(chemistry)> .


###  https://w3id.org/emmo#EMMO_4b3e2374_52a1_4420_8e3f_3ae6b9bf7dff
:EMMO_4b3e2374_52a1_4420_8e3f_3ae6b9bf7dff rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_2031516a_2be7_48e8_9af7_7e1270e308fe ,
                                                           :EMMO_7509da43_56b1_4d7f_887a_65d1663df4ba ;
                                           skos:example "An alcoholic beverage with ethanol dissolved in water (e.g., beer)."@en ;
                                           skos:prefLabel "LiquidSolution"@en ;
                                           :elucidation "A liquid solution made of two or more component substances."@en ;
                                           :wikipediaReference <https://en.wikipedia.org/wiki/Solution_(chemistry)#Liquid_solutions> .


###  https://w3id.org/emmo#EMMO_4c21fb86_fdcf_444e_b498_86fe656295af
:EMMO_4c21fb86_fdcf_444e_b498_86fe656295af rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_4e9fd152_147b_4564_8999_089608f41aff ,
                                                           :EMMO_87ac88ff_8379_4f5a_8c7b_424a8fff1ee8 ,
                                                           :EMMO_fc9222ed_14af_419b_b9df_b6a8a04e9d38 ;
                                           skos:prefLabel "Plasma"@en ;
                                           :conceptualisation """The gaseous state grades into plasma once a non-negligible fraction of particles ionizes. Unlike vapor to liquid, this is generally a continuous ionization crossover, governed by Saha equilibrium under LTE, rather than a first-order phase transition with a sharp coexistence curve and latent heat. 
That's precisely why \"fourth state of matter\" is a loose pedagogical label rather than a thermodynamically rigorous one: there's no Tc​-analogue, no discontinuity in the order parameter, just a smooth rise in ionization degree."""@en ;
                                           :elucidation "A fluid in which a gas is ionized to a level where its electrical conductivity allows long-range electric and magnetic fields to dominate its behaviour."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_4c21fb86_fdcf_444e_b498_86fe656295af ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "Plasma"@en ;
   :etymology """From Late Latin plasma (“mold”), from Ancient Greek πλάσμα (plásma, “something formed”) [Wiktionary]
The term has been introduced in physics by Irving Langmuir in 1928."""@en
 ] .


###  https://w3id.org/emmo#EMMO_4d604a13_d1f6_42fd_818f_d3138d5e308c
:EMMO_4d604a13_d1f6_42fd_818f_d3138d5e308c rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1 ;
                                           skos:altLabel "SubcriticalGaseousState"@en ;
                                           skos:prefLabel "Vapor"@en ;
                                           :conceptualisation "Vapor is defined as the gas-phase form of a substance that is below its critical temperature T𞁞, meaning it can be condensed to liquid by pressure alone (condensability). It is a single, homogeneous phase. Vapos are typically invisible."@en ;
                                           :elucidation "A gas made of a substance below its critical temperature"@en .


###  https://w3id.org/emmo#EMMO_4e9fd152_147b_4564_8999_089608f41aff
:EMMO_4e9fd152_147b_4564_8999_089608f41aff rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
                                           rdfs:isDefinedBy <https://doi.org/10.1351/goldbook.12743> ;
                                           skos:altLabel "AmorphousNetwork"@en ;
                                           skos:prefLabel "AmorphousState"@en ;
                                           :conceptualisation "Amorphous substances are characterized by the absence of regular long-range order within their atomic networks, distinguishing them from highly ordered crystalline lattices. This structural disorder prevents the formation of regular macroscopic geometric facets. Thermodynamically and physically, this manifests as a lack of a distinct melting point, irregular fracture behavior, diffuse X-ray diffraction patterns, and isotropic mechanical, optical, and electrical properties."@en ;
                                           :elucidation "State of matter characterised by the absence of long-range molecular order."@en ;
                                           :iupacReference <https://doi.org/10.1351/goldbook.12743> ;
                                           :note "If you look at the fundamental IUPAC (International Union of Pure and Applied Chemistry) definition, \"amorphous\" simply means a material lacks long-range translational order. Under this pure structural definition, liquids, gases, plasmas, and supercritical fluids are all amorphous states of matter. They have no crystalline lattice, no unit cells, and no repeating 3D patterns. If you take an X-ray diffraction scan of a liquid, you get the exact same broad, featureless \"amorphous halo\" that you get from a piece of solid glass. Therefore, structural physicists routinely refer to liquids as amorphous networks."@en ,
                                                 "In the absence of stress, the structure and properties of the amorphous state are generally isotropic at a large-enough scale, as in liquids, but they can readily develop functional/property anisotropy under the right conditions."@en ,
                                                 "One of the most common technique to define if a substance is lacking of a regular structure (amorphous) is to look at its x-ray diffraction pattern. A diffuse and poorly defined pattern is typical of an amorphous structure, while a regular reproducible pattern is typical of a crystalline structure."@en ,
                                                 "Some degree of local order about 1 nm  in length may exist in the amorphous state."@en ;
                                           :wikipediaReference <https://en.wikipedia.org/wiki/Amorphous_solid> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_4e9fd152_147b_4564_8999_089608f41aff ;
