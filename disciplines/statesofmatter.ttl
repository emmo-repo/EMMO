                                           skos:prefLabel "SupersaturatedVapor"@en ;
                                           :conceptualisation "A metastable saturated vapor carried past the saturation point without nucleating (cloud chambers, condensing nozzle flow, atmospheric supersaturation)."@en .


###  https://w3id.org/emmo#EMMO_12a9a254_9791_4a00_b045_f397bc3ab2bc
:EMMO_12a9a254_9791_4a00_b045_f397bc3ab2bc rdf:type owl:Class ;
                                           owl:equivalentClass [ owl:intersectionOf ( :EMMO_04f2a2d5_e799_4692_a654_420e76f5acc1
                                                                                      :EMMO_ec2c8ac8_98c5_4c74_b85b_ff8e8ca6655c
                                                                                    ) ;
                                                                 rdf:type owl:Class
                                                               ] ;
                                           skos:prefLabel "GasMixture"@en ;
                                           :elucidation "A mixture that behave macroscopically as a gas, even if it is composed of multi-phase/multi-state components."@en ;
                                           :note "Usually the gas-like behavior is retained when the ratio between non-gaseous and gaseous components volumes is very small."@en .


###  https://w3id.org/emmo#EMMO_1f5e3e7e_72c9_40d4_91dd_ae432d7b7018
:EMMO_1f5e3e7e_72c9_40d4_91dd_ae432d7b7018 rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_6c487fb3_03d1_4e56_91ed_c2e16dcbef60 ;
                                           skos:prefLabel "Foam"@en ;
                                           :elucidation "A colloid formed by trapping pockets of gas in a liquid or solid."@en .


###  https://w3id.org/emmo#EMMO_2031516a_2be7_48e8_9af7_7e1270e308fe
:EMMO_2031516a_2be7_48e8_9af7_7e1270e308fe rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_0b15f4ae_092e_4487_9100_3c44176c545c ,
                                                           :EMMO_0e6378df_1ce8_4321_b00c_ee9beea60a67 ;
                                           rdfs:seeAlso <https://doi.org/10.1351/goldbook.S05746> ;
                                           skos:prefLabel "Solution"@en ;
                                           :elucidation "A solution is a homogeneous mixture composed of two or more substances, when for convenience one (or more) substance, which is called the solvent, is treated differently from the other substances, which are called solutes."@en ;
                                           :note "IUPAC Goldbook definition is restricted to liquid or solid solutions. Here we extend the concept also to gas."@en ,
                                                 "Solutions are characterized by the occurrence of Rayleigh scattering on light,"@en ;
                                           :wikipediaReference <https://en.wikipedia.org/wiki/Solution_(chemistry)> .


###  https://w3id.org/emmo#EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd
:EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
                                           owl:disjointWith :EMMO_fc9222ed_14af_419b_b9df_b6a8a04e9d38 ;
                                           skos:altLabel "CondensedState"@en ;
                                           skos:prefLabel "CondensedMatter"@en ;
                                           :OWLRL2DLAxioms "Equivalent To: Liquid or Solid" ;
                                           :conceptualisation "The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with \"condensed\" phases of matter: systems of many constituents with strong interactions between them."@en ;
                                           :elucidation "Matter in liquid or solid physical state."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "CondensedMatter"@en ;
   rdfs:seeAlso <https://en.wiktionary.org/wiki/condense> ;
   :etymology "From Latin condēnsō, con- (“with, together”) + dēnsō (“thicken”) [Wiktionary]"@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd ;
   owl:annotatedProperty :conceptualisation ;
   owl:annotatedTarget "The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with \"condensed\" phases of matter: systems of many constituents with strong interactions between them."@en ;
   :wikipediaReference "https://en.wikipedia.org/wiki/Condensed_matter_physics"@en
 ] .


