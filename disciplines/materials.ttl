###  https://w3id.org/emmo#EMMO_ec613a57_0c55_42cf_ba62_2f6b6576eb2e
:EMMO_ec613a57_0c55_42cf_ba62_2f6b6576eb2e rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_4207e895_8b83_4318_996a_72cfb32acd94 ;
                                           skos:prefLabel "MaterialByIsotropy"@en ;
                                           :conceptualisation "A material is property-isotropic with respect to a given property if that property has the same value regardless of the direction in which you measure it. Isotropy is always property-specific: a material can be isotropic in one property and anisotropic in another simultaneously."@en ;
                                           :elucidation "The class for materials categorised according to the isotropicity of their properties."@en .


###  https://w3id.org/emmo#EMMO_f00fb163_48c9_4c59_b6c2_4205c082aa54
:EMMO_f00fb163_48c9_4c59_b6c2_4205c082aa54 rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_39348191_08fd_4bb6_9b1e_012d5b2f1ff6 ;
                                           rdfs:seeAlso isbn:9780080966656 ,
                                                        isbn:9780471736967 ;
                                           skos:prefLabel "MaterialByStructure"@en ;
                                           :elucidation "The superclass for all materials that are categorised according to their periodicity/crystalline structure"@en ;
                                           :note "The distinction between amorphous and crystalline is about structural isotropy. Property isotropy is not necessarly related to structural isotropy (e.g., an amorphous material can express some anisotropic property under external conditions such a stress, flow, fields)."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_f00fb163_48c9_4c59_b6c2_4205c082aa54 ;
   owl:annotatedProperty :note ;
   owl:annotatedTarget "The distinction between amorphous and crystalline is about structural isotropy. Property isotropy is not necessarly related to structural isotropy (e.g., an amorphous material can express some anisotropic property under external conditions such a stress, flow, fields)."@en ;
   rdfs:seeAlso :EMMO_ec613a57_0c55_42cf_ba62_2f6b6576eb2e
 ] .


###  https://w3id.org/emmo#EMMO_f1025834_0cd2_42a1_bfeb_13bec41c8655
:EMMO_f1025834_0cd2_42a1_bfeb_13bec41c8655 rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd ,
                                                           :EMMO_f00fb163_48c9_4c59_b6c2_4205c082aa54 ;
                                           rdfs:isDefinedBy <https://dictionary.iucr.org/Crystal> ;
                                           skos:altLabel "CrystallineMaterial"@en ;
                                           skos:prefLabel "CrystallineState"@en ;
                                           :elucidation "A material is a crystal if it has essentially a sharp diffraction pattern. The word essentially means that most of the intensity of the diffraction is concentrated in relatively sharp Bragg peaks, besides the always present diffuse scattering."@en ;
                                           :iupacReference <https://doi.org/10.1351/goldbook.12754> ;
                                           :note """A crystalline state is always condensed matter since it cannot be gaseous. In fact, in a gas we observe:
a) Thermal Dominance: The kinetic energy kB T of the particles completely overwhelms any attractive intermolecular forces
b) Mean Free Path: Gas particles are separated by vast distances relative to their size and are in constant, chaotic, random motion. They collide and scatter continuously.
Because a gas has absolutely zero correlation between the position and orientation of neighboring particles over time, it possesses no translational or orientational order which is the definition of a crystalline state."""@en ,
                                                 """Crystalline state can be solid or liquid. In fact, crystallinity is defined by atomic or molecular order, not by mechanical rigidity. Historically, \"crystal\" and \"solid\" were used interchangeably because the most common materials with long-range atomic order happen to be rigid. 
However, the modern definition focuses entirely on symmetry and diffraction patterns. If a material has a regular, repeating spatial arrangement that produces a sharp, discrete X-ray diffraction pattern, it possesses crystallinity. If a material can permanently resist a shear force without flowing, it is mechanically a solid. Because these two properties are governed by different physical mechanisms, they can be decoupled."""@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_f1025834_0cd2_42a1_bfeb_13bec41c8655 ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "CrystallineState"@en ;
   :etymology "From Ancient Greek κρύσταλλος (krústallos, “clear ice”), from κρύος (krúos, “frost”) [Wiktionary]"@en
 ] .


