###  https://w3id.org/emmo#EMMO_660a4964_0333_4663_bc66_e93ef59b0679
:EMMO_660a4964_0333_4663_bc66_e93ef59b0679 rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_bc37743c_37c4_4ec7_9d58_d1aae5567352 ;
