###  https://w3id.org/emmo#EMMO_48fc6f16_0f04_4e86_a9fc_fcfc14c5ef4b
:EMMO_48fc6f16_0f04_4e86_a9fc_fcfc14c5ef4b rdf:type owl:Class ;
