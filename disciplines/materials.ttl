###  https://w3id.org/emmo#EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd
:EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd rdf:type owl:Class ;
                                           rdfs:subClassOf :EMMO_b9695e87_8261_412e_83cd_a86459426a28 ;
                                           skos:altLabel "CondensedState"@en ;
                                           skos:prefLabel "CondensedMatter"@en ;
                                           :OWLRL2DLAxioms "Equivalent To: Liquid or Solid" ;
                                           :conceptualisation "The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with \"condensed\" phases of matter: systems of many constituents with strong interactions between them."@en ;
                                           :elucidation "Matter in liquid or solid physical state."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "CondensedMatter"@en ;
   rdfs:seeAlso <https://en.wiktionary.org/wiki/condense> ;
   :etymology "From Latin condēnsō, con- (“with, together”) + dēnsō (“thicken”) [Wiktionary]"@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd ;
   owl:annotatedProperty :conceptualisation ;
   owl:annotatedTarget "The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with \"condensed\" phases of matter: systems of many constituents with strong interactions between them."@en ;
   :wikipediaReference "https://en.wikipedia.org/wiki/Condensed_matter_physics"@en
 ] .


