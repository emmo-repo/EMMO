   owl:annotatedTarget "CeramicMaterial"@en ;
   rdfs:seeAlso <https://en.wiktionary.org/wiki/ceramic> ;
   :etymology "From Ancient Greek κεραμικός (keramikós, “potter's”) [Wiktionary]"@en
