                                           rdfs:isDefinedBy isbn:9780387986562 ;
                                           skos:prefLabel "Powder"@en ;
                                           :elucidation "A powder is a granular material composed of many very fine dry solid particles that may flow freely when shaken or tilted."@en ;
                                           :wikipediaReference "https://en.wikipedia.org/wiki/Powder"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EMMO_29a15bcd_e219_4afc_9f82_9d3fceb666cd ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "Powder"@en ;
   rdfs:seeAlso <https://en.wiktionary.org/wiki/powder> ;
   :etymology "From Latin pulverem, accusative singular of Latin pulvis (“dust, powder”) [Wiktionary]"@en
 ] .


